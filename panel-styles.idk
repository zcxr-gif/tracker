/**
 * LandingUI.js
 * REDESIGN: Tactical Modal - Advanced Centralized Filter Engine
 * UPDATED: Integrated Search Dropdown Logic
 */

export const LandingUI = {
    _isVisible: false,
    _modalOpen: false,
    _weatherMenuOpen: false,
    _activeFilters: {}, 
    _currentServer: 'Expert', // Default server

    filterGroups: {
        flight: {
            label: "Flight Data",
            filters: [
                { id: 'phase', label: 'Flight Phase', icon: 'fa-plane-circle-check', type: 'select', options: ['Ground', 'Climb', 'Cruise', 'Descent'] },
                { id: 'altitude', label: 'Altitude (ft)', icon: 'fa-arrow-up-right-dots', type: 'range', min: 0, max: 60000, step: 1000 },
                { id: 'speed', label: 'Speed (GS)', icon: 'fa-gauge-high', type: 'range', min: 0, max: 1200, step: 50 },
                { id: 'vspeed', label: 'Vert. Speed', icon: 'fa-angles-up', type: 'range', min: -6000, max: 6000, step: 500 }
            ]
        },
        aircraft: {
            label: "Aircraft Info",
            filters: [
                { id: 'category', label: 'Category', icon: 'fa-tags', type: 'select', options: ['Commercial', 'General Aviation', 'Military', 'Cargo'] },
                { id: 'livery', label: 'Livery Search', icon: 'fa-paint-roller', type: 'text' },
                { id: 'callsign', label: 'Callsign Prefix', icon: 'fa-id-badge', type: 'text' }
            ]
        },
        network: {
            label: "Network",
            filters: [
                { id: 'group', label: 'Group Flights Only', icon: 'fa-users', type: 'toggle' },
                { id: 'va', label: 'Verified VA/VO', icon: 'fa-shield-check', type: 'toggle' },
                { id: 'staff', label: 'Staff/Moderators', icon: 'fa-star', type: 'toggle' }
            ]
        }
    },

    async init() {
        if (document.getElementById('landing-ui-container')) return;
        
        this.injectStyles();
        this.render();
        this.attachListeners();
        
        // Check local storage for previous visibility state
        const savedVisibility = localStorage.getItem('landingUI_visible');
        if (savedVisibility === 'false') {
            this.update(false);
        } else {
            this._isVisible = true;
        }
    },

    /**
     * LOCAL SEARCH ENGINE
     * Fetches data from flight.js hook and renders local dropdown
     */
    handleLocalSearch(query) {
        const resultsContainer = document.getElementById('blade-search-results');
        if (!query || query.length < 2) {
            resultsContainer.innerHTML = '';
            resultsContainer.classList.remove('visible');
            return;
        }

        // Get live data from flight.js global hook
        const flights = window.getLiveFlightData ? window.getLiveFlightData() : [];
        const upperQuery = query.toUpperCase();

        // Filter flights by callsign or pilot username
        const matches = flights.filter(f => {
            const p = f.properties;
            const callsignMatch = p.callsign?.toUpperCase().includes(upperQuery);
            const userMatch = p.username?.toUpperCase().includes(upperQuery);
            const aircraftMatch = p.aircraftName?.toUpperCase().includes(upperQuery);
            return callsignMatch || userMatch || aircraftMatch;
        });

        this.renderSearchResults(matches);
    },

    renderSearchResults(matches) {
        const container = document.getElementById('blade-search-results');
        
        if (matches.length === 0) {
            container.innerHTML = `
                <div class="search-no-results">
                    <i class="fa-solid fa-plane-slash"></i>
                    <span>No matching flights</span>
                </div>
            `;
        } else {
            container.innerHTML = matches.slice(0, 15).map(f => `
                <div class="search-result-item" 
                     onclick="window.handleSearchResultClick ? window.handleSearchResultClick('${f.properties.flightId}', ${f.geometry.coordinates[1]}, ${f.geometry.coordinates[0]}) : console.log('Click:', '${f.properties.flightId}')">
                    <div class="res-main">
                        <span class="res-callsign">${f.properties.callsign || 'N/A'}</span>
                        <span class="res-aircraft">${f.properties.aircraftName || ''}</span>
                    </div>
                    <div class="res-sub">
                        <span class="res-pilot"><i class="fa-solid fa-user"></i> ${f.properties.username || 'Anonymous'}</span>
                        <span class="res-alt">${Math.round(f.properties.altitude || 0)}ft</span>
                    </div>
                </div>
            `).join('');
        }
        
        container.classList.add('visible');
    },

    render() {
        const container = document.createElement('div');
        container.id = 'landing-ui-container';
        
        const html = `
            <div id="landing-main-blade" class="landing-blade-wrapper">
                <div class="top-right-actions">
                    <div class="search-blade">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                        <input type="text" id="blade-search-input" placeholder="Quick search..." autocomplete="off">
                        <div class="search-shortcut">⌘K</div>
                        <!-- Internal Search Results Dropdown -->
                        <div id="blade-search-results" class="search-results-dropdown custom-scroll"></div>
                    </div>
                </div>

                <div class="bottom-orb-menu">
                    <div class="orb-row">
                        <div class="orb-btn tactical-trigger" data-tooltip="Tactical Filters">
                            <i class="fa-solid fa-sliders"></i>
                        </div>
                        <div class="orb-btn settings-trigger" data-tooltip="Global Settings">
                            <i class="fa-solid fa-cog"></i>
                        </div>
                        <div class="orb-btn weather-trigger" data-tooltip="Weather Layers">
                            <i class="fa-solid fa-cloud-sun"></i>
                        </div>
                        <div class="server-status-pill">
                            <div class="status-dot pulse"></div>
                            <span id="ui-server-name">${this._currentServer}</span>
                            <div class="divider"></div>
                            <span id="ui-flight-count">0</span> <i class="fa-solid fa-plane-up" style="font-size: 10px; margin-left: 4px; opacity: 0.6;"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TACTICAL MODAL -->
            <div id="tactical-modal" class="tactical-modal">
                <div class="modal-backdrop"></div>
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="header-title">
                            <i class="fa-solid fa-shield-halved"></i>
                            <div>
                                <h2>Tactical Intelligence</h2>
                                <p>Filter live airspace data</p>
                            </div>
                        </div>
                        <button class="close-modal"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                    
                    <div class="modal-body custom-scroll">
                        ${this.renderFilterSections()}
                    </div>

                    <div class="modal-footer">
                        <button class="btn-reset">Reset All</button>
                        <button class="btn-apply">Apply Filters</button>
                    </div>
                </div>
            </div>
        `;
        
        container.innerHTML = html;
        document.body.appendChild(container);
    },

    renderFilterSections() {
        return Object.entries(this.filterGroups).map(([key, group]) => `
            <div class="filter-section">
                <h3>${group.label}</h3>
                <div class="filter-grid">
                    ${group.filters.map(f => this.renderFilterItem(f)).join('')}
                </div>
            </div>
        `).join('');
    },

    renderFilterItem(filter) {
        let inputHtml = '';
        const currentVal = this._activeFilters[filter.id] || '';

        switch(filter.type) {
            case 'select':
                inputHtml = `
                    <select class="filter-input" data-filter="${filter.id}">
                        <option value="">All</option>
                        ${filter.options.map(opt => `<option value="${opt}" ${currentVal === opt ? 'selected' : ''}>${opt}</option>`).join('')}
                    </select>`;
                break;
            case 'range':
                inputHtml = `
                    <div class="range-wrapper">
                        <input type="range" class="filter-input" data-filter="${filter.id}" 
                               min="${filter.min}" max="${filter.max}" step="${filter.step}" value="${currentVal || filter.min}">
                        <span class="range-val">${currentVal || 'Min'}</span>
                    </div>`;
                break;
            case 'toggle':
                inputHtml = `
                    <label class="toggle-switch">
                        <input type="checkbox" class="filter-input" data-filter="${filter.id}" ${currentVal ? 'checked' : ''}>
                        <span class="slider"></span>
                    </label>`;
                break;
            default:
                inputHtml = `<input type="text" class="filter-input" data-filter="${filter.id}" placeholder="Type to search..." value="${currentVal}">`;
        }

        return `
            <div class="filter-card">
                <div class="card-icon"><i class="fa-solid ${filter.icon}"></i></div>
                <div class="card-info">
                    <label>${filter.label}</label>
                    ${inputHtml}
                </div>
            </div>
        `;
    },

    attachListeners() {
        // Toggle Visibility (Global External Hook)
        window.addEventListener('keydown', (e) => {
            if (e.metaKey && e.key === 'k') {
                e.preventDefault();
                document.getElementById('blade-search-input')?.focus();
            }
        });

        // Search Input - Use Local Search logic
        const searchInput = document.getElementById('blade-search-input');
        searchInput?.addEventListener('input', (e) => {
            this.handleLocalSearch(e.target.value);
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            const dropdown = document.getElementById('blade-search-results');
            const searchBlade = document.querySelector('.search-blade');
            if (dropdown && !searchBlade.contains(e.target)) {
                dropdown.classList.remove('visible');
            }
        });

        // Tactical Trigger
        document.querySelector('.tactical-trigger')?.addEventListener('click', () => this.toggleModal(true));
        document.querySelector('.close-modal')?.addEventListener('click', () => this.toggleModal(false));
        document.querySelector('.modal-backdrop')?.addEventListener('click', () => this.toggleModal(false));

        // Settings Trigger
        document.querySelector('.settings-trigger')?.addEventListener('click', () => {
            // Dispatch event for settings module
            window.dispatchEvent(new CustomEvent('openSettings'));
        });

        // Range Value Listeners
        document.querySelectorAll('input[type="range"]').forEach(range => {
            range.addEventListener('input', (e) => {
                const valSpan = e.target.parentElement.querySelector('.range-val');
                if (valSpan) valSpan.textContent = e.target.value;
            });
        });

        // Apply Button
        document.querySelector('.btn-apply')?.addEventListener('click', () => {
            this.collectFilters();
            this.toggleModal(false);
        });

        // Reset Button
        document.querySelector('.btn-reset')?.addEventListener('click', () => {
            this._activeFilters = {};
            this.render(); // Re-render to clear inputs
            this.attachListeners();
            this.collectFilters(); // Apply empty state
        });
    },

    collectFilters() {
        const filters = {};
        document.querySelectorAll('.filter-input').forEach(input => {
            const id = input.dataset.filter;
            if (input.type === 'checkbox') {
                if (input.checked) filters[id] = true;
            } else if (input.value && input.value !== '') {
                filters[id] = input.value;
            }
        });

        this._activeFilters = filters;
        
        // Dispatch to flight.js or global filter handler
        window.dispatchEvent(new CustomEvent('filterUpdate', { 
            detail: { filters: this._activeFilters, quickSearch: document.getElementById('blade-search-input').value } 
        }));
    },

    toggleModal(open) {
        this._modalOpen = open;
        const modal = document.getElementById('tactical-modal');
        if (open) {
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        } else {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }
    },

    update(visible, stats = {}) {
        this._isVisible = visible;
        const blade = document.getElementById('landing-main-blade');
        if (!blade) return;

        if (visible) {
            blade.classList.remove('hidden');
        } else {
            blade.classList.add('hidden');
        }

        if (stats.server) {
            this._currentServer = stats.server;
            document.getElementById('ui-server-name').textContent = stats.server;
        }
        if (stats.flights !== undefined) {
            document.getElementById('ui-flight-count').textContent = stats.flights;
        }
        
        localStorage.setItem('landingUI_visible', visible);
    },

    injectStyles() {
        const css = `
            .landing-blade-wrapper {
                position: fixed;
                inset: 0;
                pointer-events: none;
                z-index: 900;
                font-family: 'Inter', sans-serif;
                transition: opacity 0.4s ease;
            }
            .landing-blade-wrapper.hidden { opacity: 0; visibility: hidden; }

            /* Top Search Bar */
            .top-right-actions { position: absolute; top: 30px; right: 40px; pointer-events: auto; }
            .search-blade { 
                background: rgba(10, 10, 10, 0.7); 
                backdrop-filter: blur(20px); 
                border: 1px solid rgba(255, 255, 255, 0.1); 
                border-radius: 100px; 
                height: 42px; 
                width: 260px; 
                display: flex; 
                align-items: center; 
                padding: 0 15px; 
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                position: relative;
            }
            .search-blade:focus-within { width: 320px; background: rgba(10,10,10,0.9); border-color: rgba(255,255,255,0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
            
            #blade-search-input { background: none; border: none; color: #fff; margin-left: 10px; width: 100%; font-size: 0.9rem; outline: none; }
            .search-icon { color: rgba(255,255,255,0.4); font-size: 0.9rem; }
            .search-shortcut { background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; font-size: 0.65rem; color: rgba(255,255,255,0.5); font-weight: 700; }

            /* Dropdown Styles */
            .search-results-dropdown {
                position: absolute;
                top: calc(100% + 10px);
                left: 0;
                right: 0;
                background: rgba(15, 15, 15, 0.95);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 16px;
                max-height: 400px;
                overflow-y: auto;
                display: none;
                box-shadow: 0 20px 40px rgba(0,0,0,0.6);
                z-index: 1001;
            }
            .search-results-dropdown.visible { display: block; }
            
            .search-result-item {
                padding: 12px 18px;
                cursor: pointer;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
                transition: background 0.2s;
            }
            .search-result-item:hover { background: rgba(255, 255, 255, 0.08); }
            .res-main { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
            .res-callsign { font-weight: 800; color: #fff; font-size: 1rem; letter-spacing: 0.5px; }
            .res-aircraft { font-size: 0.7rem; color: rgba(255,255,255,0.4); text-transform: uppercase; }
            .res-sub { display: flex; justify-content: space-between; align-items: center; }
            .res-pilot { color: #3b82f6; font-size: 0.75rem; display: flex; align-items: center; gap: 5px; }
            .res-alt { font-size: 0.75rem; color: #10b981; font-family: monospace; }
            
            .search-no-results {
                padding: 30px;
                text-align: center;
                color: rgba(255,255,255,0.3);
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            /* Bottom Menu */
            .bottom-orb-menu { position: absolute; bottom: 40px; left: 40px; pointer-events: none; }
            .orb-row { display: flex; gap: 12px; pointer-events: auto; align-items: center; }
            .orb-btn { width: 44px; height: 44px; border-radius: 12px; background: rgba(15, 15, 15, 0.6); backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.7); cursor: pointer; display: grid; place-items: center; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
            .orb-btn:hover { background: #fff; color: #000; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.3); }
            
            .server-status-pill {
                height: 44px;
                padding: 0 20px;
                background: rgba(15, 15, 15, 0.6);
                backdrop-filter: blur(15px);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 12px;
                display: flex;
                align-items: center;
                gap: 12px;
                color: #fff;
                font-size: 0.85rem;
                font-weight: 600;
            }
            .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #10b981; }
            .status-dot.pulse { animation: statusPulse 2s infinite; }
            @keyframes statusPulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
            .divider { width: 1px; height: 16px; background: rgba(255,255,255,0.1); }

            /* Tactical Modal */
            .tactical-modal { position: fixed; inset: 0; z-index: 2000; visibility: hidden; opacity: 0; transition: all 0.3s ease; display: grid; place-items: center; }
            .tactical-modal.active { visibility: visible; opacity: 1; }
            .modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); }
            .modal-content { 
                position: relative; 
                width: 90%; 
                max-width: 800px; 
                background: #0a0a0a; 
                border: 1px solid rgba(255,255,255,0.1); 
                border-radius: 24px; 
                overflow: hidden; 
                transform: scale(0.9) translateY(20px); 
                transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            }
            .tactical-modal.active .modal-content { transform: scale(1) translateY(0); }
            
            .modal-header { padding: 30px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center; }
            .header-title { display: flex; gap: 15px; align-items: center; }
            .header-title i { font-size: 1.8rem; color: #3b82f6; }
            .header-title h2 { font-size: 1.4rem; margin: 0; }
            .header-title p { margin: 0; color: rgba(255,255,255,0.4); font-size: 0.85rem; }
            .close-modal { background: none; border: none; color: #fff; cursor: pointer; font-size: 1.2rem; opacity: 0.5; transition: 0.2s; }
            .close-modal:hover { opacity: 1; transform: rotate(90deg); }

            .modal-body { padding: 30px; max-height: 60vh; overflow-y: auto; }
            .filter-section { margin-bottom: 35px; }
            .filter-section h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px; color: #3b82f6; margin-bottom: 20px; }
            .filter-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; }
            
            .filter-card { 
                background: rgba(255,255,255,0.03); 
                border: 1px solid rgba(255,255,255,0.05); 
                border-radius: 16px; 
                padding: 15px; 
                display: flex; 
                gap: 15px; 
                align-items: center; 
                transition: 0.2s;
            }
            .filter-card:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); }
            .card-icon { width: 40px; height: 40px; background: rgba(59, 130, 246, 0.1); color: #3b82f6; border-radius: 12px; display: grid; place-items: center; font-size: 1rem; }
            .card-info { flex: 1; }
            .card-info label { display: block; font-size: 0.75rem; color: rgba(255,255,255,0.5); margin-bottom: 5px; }
            
            .filter-input { width: 100%; background: none; border: none; color: #fff; font-size: 0.9rem; padding: 0; outline: none; font-weight: 500; }
            .range-wrapper { display: flex; flex-direction: column; gap: 5px; }
            .range-val { font-size: 0.7rem; color: #3b82f6; font-weight: 700; }
            
            .modal-footer { padding: 25px 30px; background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: flex-end; gap: 15px; }
            .btn-reset { background: none; border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 12px 25px; border-radius: 12px; cursor: pointer; transition: 0.2s; font-size: 0.9rem; }
            .btn-reset:hover { background: rgba(255,0,0,0.1); border-color: rgba(255,0,0,0.3); }
            .btn-apply { background: #3b82f6; color: #fff; border: none; padding: 12px 30px; border-radius: 12px; cursor: pointer; font-weight: 600; font-size: 0.9rem; transition: 0.2s; }
            .btn-apply:hover { background: #2563eb; box-shadow: 0 0 20px rgba(59,130,246,0.4); }

            /* Tooltips */
            [data-tooltip]:before {
                content: attr(data-tooltip);
                position: absolute;
                bottom: calc(100% + 15px);
                left: 50%;
                transform: translateX(-50%);
                padding: 6px 12px;
                background: #fff;
                color: #000;
                font-size: 0.75rem;
                font-weight: 700;
                border-radius: 6px;
                white-space: nowrap;
                opacity: 0;
                pointer-events: none;
                transition: 0.2s;
            }
            [data-tooltip]:hover:before { opacity: 1; transform: translateX(-50%) translateY(-5px); }

            .custom-scroll::-webkit-scrollbar { width: 6px; }
            .custom-scroll::-webkit-scrollbar-track { background: transparent; }
            .custom-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
            .custom-scroll::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
        `;
        const style = document.createElement('style');
        style.textContent = css;
        document.head.appendChild(style);
    }
};