# Pretty share URLs proxy to the share serverless function.
# Status 200 = rewrite (URL stays /share/<id>); the function returns
# HTML containing Open Graph meta tags plus a meta-refresh redirect
# to /?flight=<id> so the live app picks up the flight on landing.
/share/*  /.netlify/functions/share?flight=:splat  200

# Pretty flight-history replay URLs → the standalone history page.
/flights/:id/history  /history.html?flight=:id  200

# Crew Center — per-VA login/portal (see crew.html). Both the bare /crew and
# the per-VA /crew/<slug> form rewrite to the single document; the rewrite keeps
# the path + query, so crew.html reads the slug from window.location and resolves
# that VA's branding from the backend.
# The applicant join flow (also embeddable via ?embed=1). More specific than
# the catch-all below, so it must come first.
/crew/:slug/join  /crew-join.html  200
/crew/:slug/status  /crew-status.html  200
/crew      /crew.html  200
/crew/*    /crew.html  200

# Your Month — the monthly logbook report. Short URL because it is a link
# people paste, and /month.html reads like a file rather than a place.
/month     /month.html  200

# Your Profile Card — the stats card a pilot puts on their IFC profile. Same
# reasoning: it is a place people are sent to, not a file they open.
/card      /profile-card.html  200

# Pilot profiles. The page is rendered by the backend (GET /pilot/:handle in
# the database repo's server.js, which reads the profile through the Supabase
# functions and returns HTML with Open Graph tags), and nothing here served
# that path — so inflight.info/pilot/<handle>, which is the address the iOS
# app's share button hands out and the one apple-app-site-association claims,
# had no route on this site.
#
# A proxy rather than a redirect, deliberately: 200 keeps the URL on
# inflight.info, which is what makes it a universal link the app can claim and
# what makes the Open Graph unfurl show our domain.
/pilot/*  https://site--indgo-backend--6dmjph8ltlhv.code.run/pilot/:splat  200
