# The Xcode project is generated from project.yml by XcodeGen — see
# codemagic.yaml. Committing a pbxproj means unreviewable diffs and constant
# merge conflicts, so it stays out of the repo.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.ipa
*.dSYM
*.dSYM.zip
export_options.plist

.DS_Store

# The old web tracker keeps its own .gitignore in old/.
