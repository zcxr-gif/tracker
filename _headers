# Netlify response headers.
#
# Netlify's default for static files is `max-age=0, must-revalidate`, which
# costs a conditional round trip on every visit. The bundled reference data
# below changes only when it is regenerated from upstream — a handful of times
# a year — but it is by far the heaviest thing the app fetches, so the default
# means every repeat visit stalls on revalidating it.
#
# `stale-while-revalidate` gives the best of both: served instantly from cache,
# refreshed in the background, so a regenerated file reaches users on their
# next visit without anyone ever waiting on the network for it.
#
# These filenames are not content-hashed, so the max-age is kept to a day
# rather than the year you would use for immutable assets.

/airports-core.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/airports-extra.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/airports.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/runways-core.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/runways-extra.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/runways.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/Boundaries.geojson
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/VATSpy.dat
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/prefix.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Universal links.
#
# iOS fetches /.well-known/apple-app-site-association when the app is installed
# and again periodically, and it wants JSON. The file deliberately has no
# extension — Apple fixes the name — so nothing infers the type from it and
# Netlify would otherwise serve it as application/octet-stream, which iOS
# ignores in silence. There is no error anywhere when this is wrong: links
# simply keep opening Safari.
#
# Never cached hard: the app IDs and paths in it change when the app does, and
# a stale copy is a set of links that open the wrong thing.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# The crew-center data client.
#
# Other people's websites load this cross-origin with a plain <script src>, so
# it needs no CORS header to run — but a site that would rather import it as a
# module, or read it with fetch, gets a 200 either way with the header below.
#
# Cached for an hour rather than a day: it is small, and a site that pasted the
# snippet in should pick up a fix within a session rather than the day after.
/crew-feed.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
